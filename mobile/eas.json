{
  "cli": {
    "version": ">= 5.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "developmentClient": false,
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "buildType": "apk"
      }
    },
    "demo": {
      "extends": "preview",
      "channel": "demo",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://uwc-api-demo-production.up.railway.app",
        "EXPO_PUBLIC_FEATURE_DEMO_LOGIN": "true"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
