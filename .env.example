# Database (get from Railway after creating PostgreSQL service)
DATABASE_URL="postgresql://user:password@host:port/dbname"

# JWT (generate random 64-char strings)
JWT_ACCESS_SECRET="replace-with-random-64-char-string"
JWT_REFRESH_SECRET="replace-with-different-random-64-char-string"
JWT_ACCESS_EXPIRY="30m"
JWT_REFRESH_EXPIRY="7d"

# Server
PORT=3000
NODE_ENV=development

# Cloudinary (photo/document storage — get from cloudinary.com free account)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Google Maps. ROUTING is still not runtime (road geometry is PRE-COMPUTED
# offline and shipped as RouteLeg data — see api/scripts/gen-route-legs.ts).
# GEOCODING however now runs at consignee creation (fire-and-forget; see
# api/src/lib/geocodeConsignee.ts) as well as via the batch script
# api/scripts/geocode-google.ts. Leave the key unset to disable creation-time
# geocoding entirely — consignees then stay on the zone fallback until a
# batch run. The Android app's googleMaps key in mobile/app.json is a
# separate, package-restricted key, unrelated to this one.
GOOGLE_MAPS_KEY=""

# Expo Push Notifications (get from expo.dev)
EXPO_ACCESS_TOKEN=""

# App
APP_URL="http://localhost:3000"
# Local dev origin of the Expo web app (comma-separated allowlist in prod).
CORS_ORIGIN="http://localhost:8081"

# Stuck-trip attention report (GET /reports/attention) thresholds, in hours
ATTENTION_STALE_INPROGRESS_HOURS=8
ATTENTION_OVERDUE_ASSIGNED_HOURS=2

# Early-tap review flag (same report; detection only — never blocks, never
# pays). ⚠ OUR OWN engineering defaults, NOT client rules: flag a delivery
# confirm whose nearest GPS fix (within the window) is beyond the radius.
ATTENTION_EARLY_TAP_RADIUS_M=500
ATTENTION_EARLY_TAP_WINDOW_MIN=10

# Sustainability ESTIMATE constants (display-only KPIs; never pay/dispatch).
# ⚠ OUR OWN engineering estimates, NOT client-specified figures.
# Consolidation ("empty-mile") savings — GET /reports/consolidation:
EST_KM_PER_DELIVERY=35
EST_L_PER_100KM=30
FUEL_CO2E_KG_PER_LITRE=2.68
# Right-sizing (smallest-fit dispatch) savings — same endpoint, rightSizing:
# assumed loaded consumption per truck class and average km per trip.
EST_L100_10T=32
EST_L100_5T=22
EST_L100_1T=12
EST_KM_PER_TRIP=35

# Operating-window drive scaling: zone points equal to ONE flat OP_DRIVE_MIN_PER_LEG
OP_DRIVE_POINTS_BASELINE=3
