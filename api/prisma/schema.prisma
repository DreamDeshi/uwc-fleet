// UWC Trucking Management System — Prisma schema
// Started as 16 tables (Development Brief Section 5); now 20 — AppSetting,
// TripStatusHistory, PublicHoliday and DriverLeave were added as the features
// landed. Money fields are always Decimal, never Float (no binary-float cents).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ────────────────────────────────────────────────────────────

enum Role {
  admin
  driver
  requestor
}

enum UserStatus {
  pending_approval
  active
  disabled
}

// Lifecycle: pending → assigned → in_progress → completed, with rejected and
// cancelled as terminal exits. (`approved` exists for a two-step approve-then-
// assign flow; the current code assigns in one step, so trips normally skip it —
// the conflict checker still treats it as occupying the driver, to be safe.)
enum TripStatus {
  pending
  approved
  rejected
  assigned
  in_progress
  pending_approval // all stops delivered; incentive computed but NOT paid until an admin approves the POD (Mr. Teh 16 Jul 2026)
  completed
  cancelled
}

enum StopStatus {
  pending
  arrived
  delivered
}

// ── Failed-delivery / exception workflow enums (Phase 1) ─────────────────
// Mr. Teh's Q2 diagram: driver "Report Exception" with a category → admin
// review/decision. These are the FIVE categories he listed (A–E). Kept separate
// from any per-stop reason code (there is none in Phase 1 — a stop-level failure
// is a `customer_site`/`cargo` exception with free-text reason + photo evidence).
enum ExceptionCategory {
  customer_site // A. Customer / Site Problem (closed / nobody to receive) — Q2(a)
  truck // B. Truck Problem (breakdown, etc.)
  cargo // C. Cargo Problem (goods rejected / damaged)
  external // D. External Problem (flood, weather, security)
  documentation // E. Documentation Problem (missing/wrong POD, customs rejected)
}

// Admin decision after an exception (Teh's button set). `return_cargo` is a
// RESOLUTION value, not a TripStatus. Phase 1 EXECUTES only `resume` and `retry`
// (both keep the trip in_progress and change no pay/capacity); the others are
// recorded-as-choices only in a later phase — the route refuses them for now so
// no frozen capacity/cancellation/reschedule path is crossed.
enum ExceptionResolution {
  resume
  retry
  reschedule
  reassign_lorry
  reassign_driver
  return_cargo
  cancel
}

// DERIVED header projection of the latest action (source of truth = the
// append-only ExceptionAction log). `resolved`/`rejected` are terminal (closed).
enum ExceptionState {
  reported
  more_evidence
  verified
  rejected
  resolved
}

// The append-only action log's discriminator.
enum ExceptionActionType {
  report
  request_more_evidence
  verify
  reject
  resume
  resolve
  evidence_added // driver resubmitted evidence (append-only; never reopens a closed exception)
}

// Evidence media type (photo for Phase 1; extensible).
enum ExceptionEvidenceKind {
  photo
}

// Immutable trip-lifecycle milestones. One row is appended per transition; rows
// are never updated or deleted, so the table doubles as audit evidence and backs
// the status timeline shown to admin / requestor / driver. Stop-scoped events
// (arrived/delivered) repeat per stop on multi-stop trips.
enum TripEvent {
  booked
  edited // requestor corrected their still-pending booking; note lists what changed
  assigned
  unassigned // admin pulled the driver off an assigned trip (back to pending)
  reassigned // admin moved an assigned trip to a different driver+truck
  started
  stop_arrived
  stop_delivered
  completed
  rejected
  cancelled
  assigned_external
  rerouted // reserved for the reroute workflow (roadmap item #3)
  incentive_approved // admin approved the POD + confirmed/edited the incentive (16 Jul 2026 approval gate)
}

enum DocumentType {
  do_photo
  k2_form
  other
}

enum DispatchMode {
  manual
  auto
}

// ── 1. User ──────────────────────────────────────────────────────────
// One table for all three roles — `role` decides what the account can do,
// `status` whether it can log in at all (new registrations wait in
// pending_approval until an admin approves). Drivers are pinned 1:1 to their
// truck via assigned_truck_plate, mirroring UWC's real fixed driver-truck pairs.
model User {
  id                   String      @id @default(cuid())
  phone                String      @unique // login ID
  password_hash        String
  refresh_token_hash   String? // current rotated refresh token, hashed
  name                 String
  employee_number      String?
  role                 Role
  status               UserStatus  @default(pending_approval)
  language_pref        String      @default("en") // en | ms | zh
  expo_push_token      String? // Expo push token for this user's current device
  department_id        String?
  department           Department? @relation(fields: [department_id], references: [id])
  assigned_truck_plate String?     @unique // drivers only — 1 driver : 1 truck
  assigned_truck       Truck?      @relation(fields: [assigned_truck_plate], references: [plate])
  created_at           DateTime    @default(now())

  trips_requested  Trip[]        @relation("RequestorTrips")
  trips_driven     Trip[]        @relation("DriverTrips")
  location_logs    LocationLog[]
  audit_logs       AuditLog[]
  fuel_logs        FuelLog[]
  consignees_added Consignee[]   @relation("ConsigneeCreatedBy")
  leaves           DriverLeave[] @relation("DriverLeaves")
}

// Per-driver leave calendar — feeds DISPATCH availability, not pay. A driver
// whose leave covers a trip's pickup MYT date is excluded from auto-dispatch
// candidates and blocked in the manual approve (409 DRIVER_ON_LEAVE); their
// login stays intact (leave is availability, NOT the disable status — which
// revokes access entirely). Dates are inclusive "YYYY-MM-DD" MYT strings,
// same convention as PublicHoliday.
model DriverLeave {
  id         String   @id @default(cuid())
  driver_id  String
  driver     User     @relation("DriverLeaves", fields: [driver_id], references: [id])
  start_date String // "YYYY-MM-DD" MYT, inclusive
  end_date   String // "YYYY-MM-DD" MYT, inclusive (= start_date for one day)
  note       String?
  created_at DateTime @default(now())

  @@index([driver_id, start_date, end_date])
}

// ── 2. Department ────────────────────────────────────────────────────
// The 15 UWC departments — pure reference data; registration requires one.
model Department {
  id    String @id @default(cuid())
  name  String @unique
  users User[]
}

// ── 3. Truck ─────────────────────────────────────────────────────────
// One row per physical lorry, keyed by plate. Carries everything dispatch and
// pay need: capacity in 4×4-pallet units, the two claim rates (weekday /
// off-peak), the daily deduction, the driver's coverage zones, per-truck
// operating hours, and the road-legal document expiries that gate dispatch.
model Truck {
  plate                    String    @id
  type                     String // e.g. "10t-30ft"
  max_pallets              Int
  entitled_claim_weekday   Decimal   @db.Decimal(10, 2)
  entitled_claim_offpeak   Decimal   @db.Decimal(10, 2)
  daily_deduction_points   Int
  // Next-day rate cutoff (client rule, Mr. Teh 3 Jul 2026): a rate edit is
  // staged in these pending_* columns and takes effect from
  // pending_rates_effective (MYT "YYYY-MM-DD", same key format as
  // PublicHoliday/DriverLeave) — always the day AFTER the edit. Assignment
  // snapshots read the rate effective at assignment time
  // (services/pendingRates.ts); a sweep folds matured values into the base
  // columns above and clears these.
  pending_claim_weekday    Decimal?  @db.Decimal(10, 2)
  pending_claim_offpeak    Decimal?  @db.Decimal(10, 2)
  pending_deduction_points Int?
  pending_rates_effective  String?
  priority_zones           String[]
  operating_hours_start    String    @default("07:00")
  // 02:00 (not 18:00) since item 12 — the operating day WRAPS midnight, running
  // 07:00 → 02:00 the next calendar day. A truck may still be given a
  // conventional same-day window (end > start); operatingWindow.ts handles both.
  operating_hours_end      String    @default("02:00")
  insurance_expiry         DateTime?
  permit_expiry            DateTime?
  road_tax_expiry          DateTime?
  is_available             Boolean   @default(true)
  // Soft-retire for a departed truck (additive, 2026-07-15). null = active;
  // set = permanently retired. Distinct from is_available (temporary/dispatch
  // gate): retiring sets BOTH retired_at=now AND is_available=false, so the
  // UNCHANGED dispatch candidate query (which filters is_available) excludes it
  // with no engine change. History (trips, fuel) is preserved — never deleted.
  retired_at               DateTime?

  driver      User?
  trips       Trip[]
  maintenance VehicleMaintenance[]
  fuel_logs   FuelLog[]
}

// ── 4. Zone ──────────────────────────────────────────────────────────

model Zone {
  code String @id // P1, P2, P3, K1, K2, A1, A2
  name String

  // Implicit many-to-many self-relation for adjacency (e.g. P2 <-> K1).
  // Prisma creates the join table automatically — not a 17th model.
  adjacentTo   Zone[] @relation("ZoneAdjacency")
  adjacentFrom Zone[] @relation("ZoneAdjacency")

  consignees        Consignee[]
  destination_rates DestinationRate[]
}

// ── 5. RouteType ─────────────────────────────────────────────────────
// The 6 booking categories (Customer/Supplier/Inter-Plant × Delivery/Return).
model RouteType {
  id    String @id @default(cuid())
  name  String @unique // Customer Delivery, Supplier Delivery, Inter-Plant Delivery,
  // Customer Return, Supplier Return, Inter-Plant Return
  trips Trip[]
}

// ── 6. DestinationRate ───────────────────────────────────────────────
// Zone → incentive points (the "first drop of the day" value the engine pays
// full). Two rows may legitimately share a zone — K2 is both Sungai Petani and
// Kuala Ketil — so the rates editor updates all rows of a zone together.
model DestinationRate {
  id                       String  @id @default(cuid())
  zone_code                String?
  zone                     Zone?   @relation(fields: [zone_code], references: [code])
  location_name            String // e.g. "Ipoh", "Kuala Lumpur"
  points                   Int // first-trip-of-day points for this destination
  // Next-day cutoff (extends client Q4, 3 Jul 2026; migration
  // 20260703130000): a points edit stages here, effective from
  // pending_points_effective (MYT "YYYY-MM-DD" = tomorrow) — same pattern as
  // Truck.pending_*. Assignment snapshots read the points effective at
  // assignment time (services/pendingRates.ts); the maturation sweep folds
  // matured values into `points`.
  pending_points           Int?
  pending_points_effective String?
}

// ── 7. Trip ──────────────────────────────────────────────────────────
// The core record: one booking through its whole life. Note the money fields —
// incentive_earned stores the PER-TRIP MARGINAL amount (summing a day's trips
// gives the day total), and the three nullable rate columns are the
// assignment-time snapshot (rate lock) that finalization pays at.
model Trip {
  id                        String         @id @default(cuid())
  ticket_number             String         @unique // TKT-YYYYMMDD-NNN
  requestor_id              String
  requestor                 User           @relation("RequestorTrips", fields: [requestor_id], references: [id])
  driver_id                 String?
  driver                    User?          @relation("DriverTrips", fields: [driver_id], references: [id])
  truck_plate               String?
  truck                     Truck?         @relation(fields: [truck_plate], references: [plate])
  route_type_id             String
  route_type                RouteType      @relation(fields: [route_type_id], references: [id])
  status                    TripStatus     @default(pending)
  pickup_datetime           DateTime
  incentive_earned          Decimal?       @db.Decimal(10, 2)
  // Finalize-time pay EVIDENCE (written once, atomically with
  // incentive_earned; the engine's own outputs — display/verification only,
  // never read by any calculation). NULL on trips completed before this
  // feature ("breakdown not recorded"). rate_used/off_peak are also NULL on
  // the rare midnight-straddling trip whose delivery-day groups used
  // different tiers — the per-stop rows stay exact; deduction_applied sums.
  rate_used                 Decimal?       @db.Decimal(10, 2) // RM/point actually paid
  off_peak                  Boolean? // which tier picked rate_used
  deduction_applied         Int? // deduction points actually subtracted (may be < the truck's figure when floored at 0)
  // POD-approval gate (Mr. Teh 16 Jul 2026): `incentive_earned` above is the
  // engine's PROPOSAL, computed and frozen when the last stop is delivered (the
  // trip then sits `pending_approval`). At admin approval `incentive_final` is
  // set — equal to `incentive_earned`, or an admin-edited amount with a
  // mandatory `incentive_override_reason` (the original proposal is preserved
  // forever). Payroll pays COALESCE(incentive_final, incentive_earned) for
  // `completed` trips: trips completed BEFORE this feature keep incentive_final
  // NULL and are paid at their engine amount (grandfathered, no data migration).
  incentive_final           Decimal?       @db.Decimal(10, 2) // admin-confirmed pay (may differ from the proposal)
  incentive_override_reason String? // required iff incentive_final != incentive_earned
  incentive_approved_at     DateTime?
  incentive_approved_by     String? // admin User id
  // Rate-lock snapshot, written at ASSIGNMENT time (manual approve and
  // auto-dispatch both claim through it): a trip finalizes at the rates it was
  // dispatched under — a later admin rate edit affects future assignments only.
  // Null on trips assigned before the rate-lock migration; the finalization
  // path falls back to the live truck values for those.
  entitled_claim_weekday    Decimal?       @db.Decimal(10, 2)
  entitled_claim_offpeak    Decimal?       @db.Decimal(10, 2)
  daily_deduction_points    Int?
  is_external               Boolean        @default(false)
  // Admin's reason when a booking is rejected — shown to the requestor.
  rejection_reason          String?
  // Set once admins have been pinged about a 15-min-old pending order, so the
  // background alert job notifies them exactly once per trip.
  pending_alert_sent        Boolean        @default(false)
  // Set true when an auto-dispatch attempt (create-time OR the 60s sweep) finds
  // no eligible driver/truck for this booking (or, per Phase 3, the route would
  // finish past the operating window). Self-clearing: reset to false the moment
  // the trip leaves pending (assigned by a later sweep/adjacency or manually, or
  // cancelled/rejected), so the admin "needs attention" signal is never sticky.
  // Displayed state = (status == pending AND auto_dispatch_failed == true).
  auto_dispatch_failed      Boolean        @default(false)
  // WHY auto-dispatch couldn't place it (operating window / no capacity /
  // missing zone rate) — written and cleared in exactly the same places as
  // auto_dispatch_failed so it inherits the self-clearing lifecycle.
  // Display-only: no dispatch or incentive logic ever reads it.
  auto_dispatch_note        String?
  // Set true when an admin MANUALLY unassigns an assigned trip (feedback item 15,
  // 16 Jul 2026: "no more auto after unassign"). While true, the pending sweep
  // will NOT auto-dispatch this booking — it stays pinned to manual handling
  // (admin reject or manual re-assign). Cleared on any pending → assigned claim
  // (claimPendingTrip), so it strictly means "this pending trip is here because
  // an admin pulled the driver, and must not be auto-re-dispatched."
  auto_dispatch_paused      Boolean        @default(false)
  // Client-supplied idempotency key for POST /trips (DG-T7). The booking form
  // holds ONE key per booking attempt and reuses it on every retry, so a submit
  // that timed out but actually succeeded returns the ORIGINAL trip instead of
  // creating a second one — which, in `auto` dispatch mode, would immediately
  // claim a second truck. Additive and NULLABLE: every existing trip, and any
  // client too old to send a key, keeps working exactly as before (a NULL never
  // collides in Postgres, so unkeyed bookings are simply not deduplicated).
  //
  // Scoped to the requestor, NOT globally unique: a global key would let one
  // requestor's (guessed or replayed) key return ANOTHER requestor's booking.
  // Composite means a replay can only ever return your own trip.
  client_request_id         String?
  // Failed-delivery / exception workflow (Phase 1, feature-flagged). A trip's
  // exception state is DERIVED, not stored: Trip.status stays `in_progress` while
  // an exception is open. `open_exception_id` is a CACHE/pointer (cheap "has an
  // open exception" flag for the board + the report CAS), NOT the canonical
  // invariant — the partial unique index on TripException(trip_id) WHERE
  // closed_at IS NULL is (see the TripException model note). Kept transactionally
  // consistent: set null→id when an exception opens, cleared when it closes. All
  // additive/nullable; a trip with open_exception_id = null is a normal trip.
  open_exception_id         String?        @unique
  open_exception            TripException? @relation("TripOpenException", fields: [open_exception_id], references: [id])
  created_at                DateTime       @default(now())

  stops              TripStop[]
  cargo_details      CargoDetail[]
  documents          TripDocument[]
  location_logs      LocationLog[]
  external_forwarder ExternalForwarder?
  status_history     TripStatusHistory[]
  exceptions         TripException[]     @relation("TripExceptions")
  change_requests    TripChangeRequest[]

  // The idempotency constraint itself (DG-T7). This is what makes a concurrent
  // double-submit safe: the second INSERT loses on the unique index rather than
  // racing the pre-check, and the handler then returns the winner's trip.
  @@unique([requestor_id, client_request_id])
  // Keyset scan for the paged trip list (lib/tripCursor): the list orders by
  // (created_at DESC, id DESC) — same-direction columns, so this one ASC
  // composite serves it via a backward index scan. Also covers the legacy
  // newest-N limit window the other admin pages still use.
  @@index([created_at, id])
}

// ── 8. TripStop ──────────────────────────────────────────────────────
// One delivery drop on a trip; multi-stop bookings create several, in sequence.
// This is where the proof-of-delivery lives (pod_photo) and where the driver's
// per-stop Arrived/Delivered taps land.
model TripStop {
  id             String          @id @default(cuid())
  trip_id        String
  trip           Trip            @relation(fields: [trip_id], references: [id])
  sequence       Int
  consignee_id   String
  consignee      Consignee       @relation(fields: [consignee_id], references: [id])
  status         StopStatus      @default(pending)
  arrived_at     DateTime?
  delivered_at   DateTime?
  pod_photo      String? // Cloudinary delivery URL (legacy rows: public; new rows: the private/authenticated URL, not directly accessible)
  // Cloudinary public_id of the AUTHENTICATED (private-delivery) POD asset.
  // Set → the API serves a freshly-signed, unguessable URL each read
  // (lib/podPhotos.ts); NULL → legacy public pod_photo, until the backfill
  // (prisma/secure-existing-pods.ts) flips + records it. Additive, nullable.
  pod_public_id  String?
  do_uploaded    Boolean         @default(false)
  // K2 customs form (Borang K2). Mr. Teh, R1 2026-07-24 Q6: "Prefer they need
  // upload the form … we need admin to final validate and approve, only they can
  // get pay." So for a K2-zone stop the driver must UPLOAD the actual document
  // (k2_photo/_public_id, same authenticated-Cloudinary pipeline as pod_photo) —
  // the tick-box `k2_form_ack` below is now LEGACY (kept for grandfathered rows;
  // the delivery gate keys on the uploaded document). The upload is visible to
  // the admin at the existing POD/incentive approval (that IS "admin validate +
  // approve, only then pay"). All additive/nullable.
  k2_photo       String?
  k2_public_id   String?
  k2_form_ack    Boolean         @default(false) // LEGACY tick (grandfathered rows only)
  // This stop's destination-zone points, snapshotted at assignment (rate lock —
  // same rationale as the Trip claim-rate snapshot). Null = pre-migration stop;
  // finalization falls back to the live DestinationRate points.
  zone_points    Int?
  // Finalize-time scoring EVIDENCE (the engine's own outputs, written once
  // with the trip's incentive): the points this drop actually earned
  // (pre-deduction), and whether it scored as a same-zone repeat (flat 1 —
  // not derivable from points alone: a 1-point zone's first drop also
  // scores 1). NULL = completed pre-feature.
  points_awarded Int?
  was_repeat     Boolean?
  // The zone IDENTITY this drop is scored under. Snapshotted at ASSIGNMENT
  // next to zone_points (identity lock, audit 2026-07-05 #4: a mid-flight
  // consignee zone correction must not split the ledger key / evidence from
  // the snapshotted points), confirmed by the finalize evidence write, and
  // cleared with zone_points on unassign. NULL = assigned pre-snapshot →
  // finalization falls back to the consignee's live zone.
  zone_code      String?
  // Stop-scoped exceptions (Q2(a) "can't deliver"). A per-stop failure is a
  // TripException with trip_stop_id set; evidence lives in ExceptionEvidence.
  exceptions     TripException[]
}

// ── 8a. TripException / ExceptionAction / ExceptionEvidence ──────────────
// Failed-delivery / exception workflow (Phase 1, feature-flagged, MONEY-FREE).
//
// The exception is a small append-only AGGREGATE:
//   • TripException    — the header: immutable facts of ONE occurrence.
//   • ExceptionAction  — one row per driver/admin step (report/verify/reject/
//                        request_more_evidence/resume/resolve). NEVER updated.
//   • ExceptionEvidence— one row per uploaded photo (own Cloudinary public_id,
//                        served as a signed URL, SEPARATE from POD).
//
// The header's `current_state`/`resolution` are a DERIVED projection of the
// latest action, maintained transactionally on each write (source of truth = the
// actions). Idempotency: a device-generated UUID at every level
// (client_occurrence_id / client_action_id / client_evidence_id), each @@unique,
// so offline replay never duplicates a row. Optimistic concurrency via `version`.
// NO money/pay/amount columns anywhere — pay stays a deferred finalization-time
// decision. NOTE: append-only rows do NOT prevent orphaned Cloudinary assets — an
// upload whose request never commits still needs the standard 7-day unattached-
// asset cleanup (out of scope here; tracked separately).
//
// ⚠ ONE-OPEN-PER-TRIP is enforced by a PARTIAL UNIQUE INDEX in
// prisma/migrations/20260725130000_exception_hardening (UNIQUE ON (trip_id)
// WHERE closed_at IS NULL) — that DB index, NOT Trip.open_exception_id, is the
// CANONICAL invariant. Prisma cannot express partial indexes in this schema, so
// it is added by raw SQL and is intentionally NOT represented here (a future
// `prisma migrate dev` will surface it as drift — keep it). Trip.open_exception_id
// is a CACHE/pointer for cheap board queries + the report CAS, kept transactionally
// consistent with the header's closed_at.
model TripException {
  id                   String               @id @default(cuid())
  trip_id              String
  trip                 Trip                 @relation("TripExceptions", fields: [trip_id], references: [id])
  // Back-side of Trip.open_exception (the one-open-per-trip pointer/guard). Set
  // only while this exception is the trip's open one; cleared when it closes.
  open_for_trip        Trip?                @relation("TripOpenException")
  trip_stop_id         String? // Q2(a): the stop the driver could not deliver
  trip_stop            TripStop?            @relation(fields: [trip_stop_id], references: [id])
  client_occurrence_id String // device UUID → dedup on offline replay
  // SERVER-computed SHA-256 over the NORMALIZED report inputs (trip/stop, category,
  // reason, actor, client_action_id, client_evidence_id, GPS, client timestamps)
  // + the uploaded photo's byte digest. A reused client_occurrence_id whose
  // recomputed fingerprint differs is a payload change → 409 IDEMPOTENCY_KEY_REUSED;
  // an identical replay matches and returns the original committed result. Never
  // client-supplied. Nullable only for pre-feature rows (every write sets it).
  request_fingerprint  String?
  category             ExceptionCategory
  reason               String // driver's free-text at report
  reported_by          String // driver User id (no FK — matches TripStatusHistory.actor_id)
  reported_at          DateTime             @default(now()) // SERVER receipt — immutable
  client_reported_at   DateTime? // device capture time (offline gap)
  current_state        ExceptionState       @default(reported) // derived projection
  resolution           ExceptionResolution?
  resolved_at          DateTime?
  closed_at            DateTime? // set when terminal (resolved/rejected); null = OPEN
  version              Int                  @default(0) // optimistic concurrency
  created_at           DateTime             @default(now())
  actions              ExceptionAction[]
  evidence             ExceptionEvidence[]

  @@unique([trip_id, client_occurrence_id])
  @@index([trip_id, created_at])
}

model ExceptionAction {
  id               String               @id @default(cuid())
  exception_id     String
  exception        TripException        @relation(fields: [exception_id], references: [id])
  client_action_id String // device UUID → idempotent replay
  type             ExceptionActionType
  resolution       ExceptionResolution? // set only when type = resolve
  actor_id         String // User id (no FK — matches the append-only history pattern)
  actor_role       Role
  note             String? // required on reject / request_more_evidence / resolve
  // Driver-side provenance (nullable; admin actions leave null) — captured only
  // within the active-trip consent/foreground tracking gate. No off-trip capture.
  lat              Float?
  lng              Float?
  accuracy_m       Float?
  client_at        DateTime? // device capture time
  created_at       DateTime             @default(now()) // SERVER receipt — immutable
  evidence         ExceptionEvidence[] // evidence supplied by this action

  @@unique([exception_id, client_action_id])
  // Backs the composite FK on ExceptionEvidence(action_id, exception_id) that
  // enforces evidence + action belong to the SAME exception (added by raw SQL in
  // the hardening migration; id is already the PK, so this is a cheap superset).
  @@unique([id, exception_id])
  @@index([exception_id, created_at])
}

model ExceptionEvidence {
  id                 String                @id @default(cuid())
  exception_id       String
  exception          TripException         @relation(fields: [exception_id], references: [id])
  // The action that supplied this evidence (report / evidence_added). A REAL
  // relation now (was a bare String). Nullable is retained for a possible future
  // pre-action upload-session flow, but every current write sets it. A raw
  // COMPOSITE FK (action_id, exception_id) → ExceptionAction(id, exception_id) in
  // the hardening migration additionally guarantees the action belongs to the
  // SAME exception — Prisma can't express a composite FK that shares exception_id
  // with the `exception` relation above, so it is added by raw SQL (and will show
  // as drift on a future `prisma migrate dev` — keep it).
  // Restrict: actions are append-only and NEVER deleted, so SET NULL (which would
  // also try to null the NOT NULL exception_id via the composite FK) must never
  // fire — RESTRICT makes that explicit and consistent across both FKs.
  action_id          String?
  action             ExceptionAction?      @relation(fields: [action_id], references: [id], onDelete: Restrict)
  client_evidence_id String // device UUID → idempotent upload replay
  // SERVER-computed SHA-256 of the uploaded photo BYTES — the stable content
  // identity used (with uploader + capture time + kind) to distinguish a genuine
  // idempotent evidence replay from a reused UUID carrying a different photo.
  content_sha256     String?
  kind               ExceptionEvidenceKind @default(photo)
  url                String // Cloudinary authenticated URL (not directly accessible)
  public_id          String // signed per-read (lib/exceptionEvidence.ts) — SEPARATE from POD
  captured_client_at DateTime?
  uploaded_by        String // User id
  created_at         DateTime              @default(now())

  @@unique([exception_id, client_evidence_id])
  @@index([exception_id])
}

// ── 8b. PublicHoliday ────────────────────────────────────────────────
// Admin-managed public-holiday calendar — drives the incentive engine's
// weekday/off-peak decision (replaces the old hardcoded 2026 list, which
// carried wrong dates). `date` is the MYT calendar day as a "YYYY-MM-DD"
// string — the exact key isOffPeak() compares against — so there is no
// UTC/DATE-column ambiguity anywhere in the money path.
model PublicHoliday {
  id         String   @id @default(cuid())
  date       String   @unique // "YYYY-MM-DD" (MYT calendar day)
  name       String
  created_at DateTime @default(now())
}

// ── 9. Consignee ─────────────────────────────────────────────────────
// The customer/consignee master (UWC's real, NDA-protected "ship to" list —
// which is why the seed Excel is gitignored). zone_code is what links a
// delivery address into the dispatch + incentive zone model. Requestors can
// self-add a missing company; created_by records who.
model Consignee {
  id                 String  @id @default(cuid())
  company_name       String
  vendor_code        String?
  contact_person     String?
  phone              String?
  address_1          String?
  address_2          String?
  area               String?
  state              String?
  postal_code        String?
  zone_code          String
  zone               Zone    @relation(fields: [zone_code], references: [code])
  is_active          Boolean @default(true)
  created_by         String? // requestor can self-add
  created_by_user    User?   @relation("ConsigneeCreatedBy", fields: [created_by], references: [id])
  // ── Geocoded position (scripts/geocode-consignees.ts, Geoapify) ──────
  // All THREE are nullable and additive: a consignee with no geocode must behave
  // exactly as before (destination = its zone centroid). Populated offline, never
  // at request time — there is no runtime geocoding provider.
  //
  // `geocode_match_type` is Geoapify's own match_type and is the GATE, not a
  // decoration. Only `full_match` and `match_by_street` are real positions;
  // `match_by_postcode` means the street was NOT found and the point is a postcode
  // centroid — callers must treat that as NO geocode and fall back to the zone,
  // exactly like a ghosted fleet-map marker or a stale RouteLeg.
  //
  // ⚠ Geoapify's `confidence` is deliberately NOT stored. It lies: FRONTKEN came
  // back conf=1.00 on what is plainly a postcode centroid. match_type is the
  // honest field; storing confidence would invite someone to gate on it.
  //
  // Float (not Decimal like LocationLog) is intentional and sufficient: a double
  // holds ~1cm of precision at these latitudes, and these are static building
  // positions, not a GPS audit trail.
  latitude           Float?
  longitude          Float?
  geocode_match_type String?

  stops TripStop[]
}

// ── 10. CargoDetail ──────────────────────────────────────────────────
// What's on the truck for a trip. Pallet quantities are converted to
// 4×4-pallet equivalents (lib/pallets.ts) for every capacity check. Cargo is
// per-TRIP, not per-stop — which is why truck capacity frees only when the
// whole trip completes (a known, documented spec trade-off).
model CargoDetail {
  id                String  @id @default(cuid())
  trip_id           String
  trip              Trip    @relation(fields: [trip_id], references: [id])
  pallet_type       String // e.g. "4x4"; or a non-pallet type: carton/box/crate/rack/custom
  quantity          Int
  cartons           Int?
  // Q10 structured dimensions (feet) for crate/rack/custom cargo. `custom_size`
  // holds the canonical "W × L ft" display string (derived from these); a LEGACY
  // custom row may carry a free-text `custom_size` with these null — preserved
  // as-is on unrelated edits. Additive/nullable.
  width_ft          Float?
  length_ft         Float?
  custom_size       String?
  // Requestor's OPTIONAL estimated 4×4-pallet-equivalent for a "carton"/"custom"
  // (Others) line — those types carry no pallet footprint by conversion (factor
  // 0), so without an estimate auto-dispatch can't size them. When given, the
  // capacity math uses it; when absent, the booking is routed to manual
  // assignment (needs-attention) instead of silently taking the smallest truck.
  // Lives on the cargo line so it stays correct if cargo later becomes per-stop.
  estimated_pallets Int?
  remark            String?
}

// ── 11. TripDocument ─────────────────────────────────────────────────
// Requestor-uploaded paperwork (DO / invoice / other) as Cloudinary URLs.
// The driver's POD photo is NOT here — it lives on TripStop.pod_photo, per stop.
model TripDocument {
  id            String       @id @default(cuid())
  trip_id       String
  trip          Trip         @relation(fields: [trip_id], references: [id])
  type          DocumentType
  file_url      String // legacy rows: public URL; new rows: the private/authenticated URL
  // Cloudinary handle for the AUTHENTICATED (private-delivery) asset. Set → the
  // API serves a freshly-signed URL (lib/podPhotos.ts); NULL → legacy public
  // file_url, until the backfill (prisma/secure-existing-documents.ts). Additive.
  public_id     String?
  resource_type String? // "image" | "raw" — sign the right delivery URL
  format        String? // original extension (jpg/png/pdf…) so the signed URL keeps it
  uploaded_at   DateTime     @default(now())
}

// ── 12. LocationLog ───────────────────────────────────────────────────

model LocationLog {
  id          String   @id @default(cuid())
  trip_id     String
  trip        Trip     @relation(fields: [trip_id], references: [id])
  driver_id   String
  driver      User     @relation(fields: [driver_id], references: [id])
  latitude    Decimal  @db.Decimal(10, 7)
  longitude   Decimal  @db.Decimal(10, 7)
  recorded_at DateTime @default(now())
  // GPS source: "phone" (driver app, foreground + active-trip only) or "vendor"
  // (third-party hardware; ingestion not yet built, see POST /locations). The
  // fleet map prefers the freshest vendor fix, then phone. Additive; legacy rows
  // default to "phone" (all existing rows are phone GPS).
  source      String   @default("phone")

  // Supports "latest fix per trip" (GET /fleet/live) and per-trip history reads
  // as this table grows by one row per active truck every 30s.
  @@index([trip_id, recorded_at])
}

// ── 13. AuditLog ──────────────────────────────────────────────────────
// Append-only "who did what, to which record": every sensitive mutation writes
// one row. record_id is a plain string ON PURPOSE (no FK) — an audit entry must
// be able to outlive the record it describes.
model AuditLog {
  id         String   @id @default(cuid())
  user_id    String
  user       User     @relation(fields: [user_id], references: [id])
  action     String
  table_name String
  record_id  String
  timestamp  DateTime @default(now())
}

// ── 14. VehicleMaintenance ───────────────────────────────────────────
// Service history per truck — feeds the maintenance/expiry alerts (FR-MT1).
model VehicleMaintenance {
  id            String    @id @default(cuid())
  truck_plate   String
  truck         Truck     @relation(fields: [truck_plate], references: [plate])
  description   String
  service_date  DateTime
  cost          Decimal   @db.Decimal(10, 2)
  next_due_date DateTime?
}

// ── 15. ExternalForwarder ────────────────────────────────────────────
// Outsourcing details when no internal truck can take a booking (1:1 with the
// trip). External trips carry no driver incentive — the rate here is what the
// forwarder charges UWC.
model ExternalForwarder {
  id           String   @id @default(cuid())
  trip_id      String   @unique
  trip         Trip     @relation(fields: [trip_id], references: [id])
  company_name String
  booking_date DateTime
  rate         Decimal  @db.Decimal(10, 2)
  cargo_size   String
}

// ── 17. AppSetting ────────────────────────────────────────────────────
//
// Single-row table holding system-wide settings. The fixed id "singleton"
// guarantees one row: every read/write upserts against it. Currently just the
// dispatch mode (manual vs fully-automatic, Mr. Teh's requirement).
model AppSetting {
  id            String       @id @default("singleton")
  dispatch_mode DispatchMode @default(manual)
  updated_at    DateTime     @updatedAt
}

// ── 16. FuelLog ───────────────────────────────────────────────────────
// Fuel fills per truck + driver (FR-CT5) — powers the fuel cost report.
model FuelLog {
  id          String   @id @default(cuid())
  truck_plate String
  truck       Truck    @relation(fields: [truck_plate], references: [plate])
  driver_id   String
  driver      User     @relation(fields: [driver_id], references: [id])
  liters      Decimal  @db.Decimal(10, 2)
  cost        Decimal  @db.Decimal(10, 2)
  odometer    Int?
  logged_at   DateTime @default(now())
}

// ── 18. TripStatusHistory ────────────────────────────────────────────
//
// Append-only lifecycle log backing the status timeline. A row is written
// inside the same operation as each status change (see lib/tripHistory.ts).
// actor_id is null for system-driven events (auto-dispatch, background sweep).
// stop_id is set only for per-stop events (stop_arrived / stop_delivered).
// note carries human context: "<driver> · <plate>" on assign, the rejection
// reason, or the forwarder name.
model TripStatusHistory {
  id         String    @id @default(cuid())
  trip_id    String
  trip       Trip      @relation(fields: [trip_id], references: [id])
  event      TripEvent
  stop_id    String?
  actor_id   String?
  note       String?
  created_at DateTime  @default(now())

  @@index([trip_id, created_at])
}

// ── 19. RouteLeg ─────────────────────────────────────────────────────
//
// PRE-COMPUTED road geometry, generated ONCE against a locally-run
// OpenRouteService (Docker, driving-hgv profile, OSM Malaysia extract) — see
// api/scripts/gen-route-legs.mjs. It replaces the live Google Directions call:
// no API key, no quota, no per-request latency, no third-party terms.
//
// ⚠ WHY THIS IS SOUND TODAY, AND WHEN IT STOPS BEING SOUND ⚠
// Trips have no real destination coordinates: `Consignee` stores `zone_code`
// only, so routes/trips.ts routes plant → each stop's ZONE CENTROID. That makes
// the set of possible paths finite and tiny — one leg per (origin, destination)
// pair over {PLANT} ∪ {8 zone centroids} — so every route the system can ever
// ask for is a concatenation of the legs stored here.
//
// The moment consignee ADDRESSES are geocoded (the long-standing "TODO: geocode
// consignee addresses" in lib/geo.ts), destinations become per-consignee, this
// table can no longer cover them, and the pre-computed approach must be
// replaced by a live routing call again. Treat that migration as a prerequisite
// of geocoding, not an afterthought.
//
// Staleness is DETECTABLE, not assumed: each row stores the exact coordinates
// it was generated for. services/routeLegs.ts compares them against the live
// PLANT_ORIGIN / ZONE_COORDS and falls back to the straight line if they have
// drifted (e.g. the 2026-07-20 plant-coordinate correction would have invalidated
// every leg). Regenerate with the script and ship a new migration.
model RouteLeg {
  // "PLANT" for the depot, otherwise a Zone.code (P1, P2, K1, …).
  from_key     String
  to_key       String
  // Google-encoded polyline, precision 5 — decoded by lib/geo.decodePolyline
  // (ORS emits the same encoding, so the existing decoder is reused as-is).
  polyline     String
  distance_m   Int
  duration_s   Int
  // Provenance, so a stale/oddly-routed leg can be traced to how it was made.
  profile      String // ORS routing profile, e.g. "driving-hgv"
  generator    String // tool + version, e.g. "openrouteservice 9.9.0 (docker)"
  generated_at DateTime
  // The coordinates this leg was ACTUALLY routed between — the staleness guard.
  from_lat     Decimal  @db.Decimal(10, 7)
  from_lng     Decimal  @db.Decimal(10, 7)
  to_lat       Decimal  @db.Decimal(10, 7)
  to_lng       Decimal  @db.Decimal(10, 7)

  @@id([from_key, to_key])
}

// ── 25. TripChangeRequest ────────────────────────────────────────────
// Mr. Teh's A19 matrix (29 Jul 2026, DOCUMENT tier): once a lorry is ASSIGNED,
// the requestor may no longer directly change anything that affects
// auto-dispatch (delivery location, date/time, pallet quantity/size, customer).
// Instead they click "Request Change" and it goes to admin for approval.
//
// WHY A TABLE AND NOT AuditLog. The in-app feedback channel stores rows as
// AuditLog with table_name = "Feedback", and that trick was considered here and
// rejected: AuditLog has no mutable state column, no Trip relation and no unique
// constraint, so "pending vs approved" would be derived by scanning for a later
// row — with NO compare-and-set to make approve-once atomic. This flow ENDS IN
// AN ADMIN EDITING A LIVE BOOKING, so a double-approve is a real hazard.
//
// The record is deliberately a PROPOSAL, never a partial write: nothing on the
// Trip changes until an admin approves, and approval replays the payload
// through the SAME validated edit path a pending booking uses.
model TripChangeRequest {
  id            String              @id @default(cuid())
  trip_id       String
  trip          Trip                @relation(fields: [trip_id], references: [id])
  requested_by  String // requestor User id (no FK — matches the append-only history pattern)
  requested_at  DateTime            @default(now()) // SERVER receipt
  // The proposed booking, in the EXACT shape PATCH /trips/:id already accepts
  // (route_type_id, pickup_datetime, stops[], cargo_details[]). Json rather than
  // a column per field on purpose: the editable set is already defined once by
  // updateTripSchema, and duplicating it in columns guarantees the two drift.
  // Approval re-validates through that same schema, so a payload stored before a
  // validation rule changed can never bypass the new rule.
  payload       Json
  // Human summary from summarizeTripChanges — the SAME wording the trip timeline
  // uses, so the dispatcher reads one vocabulary for changes.
  summary       String
  status        ChangeRequestStatus @default(pending)
  decided_by    String? // admin User id
  decided_at    DateTime?
  // Required on reject (why the requestor did not get it) and free on approve.
  decision_note String?
  version       Int                 @default(0) // optimistic concurrency, as TripException
  created_at    DateTime            @default(now())

  // The dispatcher's queue: oldest pending first.
  @@index([status, requested_at])
  @@index([trip_id, requested_at])
}

// pending → approved | rejected, or superseded when the requestor replaces an
// undecided request with a newer one. `superseded` exists so a trip can never
// hold two pending requests that both get approved into conflicting states; the
// partial unique index in the migration enforces that at the DB level too.
enum ChangeRequestStatus {
  pending
  approved
  rejected
  superseded
}
